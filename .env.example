# ---- Aplicação ----
PORT=8082
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# ---- PostgreSQL ----
DB_URL=jdbc:postgresql://localhost:5432/mercadoexpress
DB_USER=postgres
DB_PASSWORD=SUA_SENHA
DDL_AUTO=update
SHOW_SQL=false

# ---- RabbitMQ (local: localhost/5672/guest/guest, SSL=false) ----
# CloudAMQP (use os dados de "AMQP details", nao os de MQTT):
#   RABBITMQ_HOST=<host>.lmq.cloudamqp.com
#   RABBITMQ_PORT=5671
#   RABBITMQ_SSL=true
#   RABBITMQ_VHOST=<vhost mostrado no painel>
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_SSL=false
RABBITMQ_LISTENERS=true

# ---- E-mail (local: Mailpit em localhost:1025) ----
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@mercadoexpress.com

# ---- Banco Tranquilo ----
BANCO_API_KEY=banco-tranquilo-key
BANCO_LIMITE=5000
